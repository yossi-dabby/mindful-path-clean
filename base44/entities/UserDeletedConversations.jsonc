{
  "name": "UserDeletedConversations",
  "type": "object",
  "properties": {
    "agent_conversation_id": {
      "type": "string",
      "description": "ID of the deleted agent conversation"
    },
    "conversation_title": {
      "type": "string",
      "description": "Title of the deleted conversation (for reference)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this deletion record"
    }
  },
  "required": [
    "agent_conversation_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
