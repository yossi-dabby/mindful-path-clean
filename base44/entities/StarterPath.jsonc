{
  "name": "StarterPath",
  "type": "object",
  "properties": {
    "current_day": {
      "type": "number",
      "default": 0,
      "description": "Current day in the 7-day path (0 = not started)"
    },
    "started_date": {
      "type": "string",
      "format": "date",
      "description": "When the user started the path"
    },
    "last_completed_date": {
      "type": "string",
      "format": "date",
      "description": "Last day a step was completed"
    },
    "completed": {
      "type": "boolean",
      "default": false,
      "description": "Whether all 7 days are completed"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "When the path was completed"
    },
    "day_exercises": {
      "type": "object",
      "description": "Map of day number to exercise ID completed"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this starter path record"
    }
  },
  "required": [],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
