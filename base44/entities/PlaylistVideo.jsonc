{
  "name": "PlaylistVideo",
  "type": "object",
  "properties": {
    "playlist_id": {
      "type": "string",
      "description": "Reference to Playlist"
    },
    "video_id": {
      "type": "string",
      "description": "Reference to Video"
    },
    "position": {
      "type": "number",
      "description": "Order in playlist"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this playlist entry"
    }
  },
  "required": [
    "playlist_id",
    "video_id"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
