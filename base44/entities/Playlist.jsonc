{
  "name": "Playlist",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Playlist name"
    },
    "description": {
      "type": "string",
      "description": "Optional playlist description"
    },
    "video_count": {
      "type": "number",
      "default": 0,
      "description": "Number of videos in this playlist"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
