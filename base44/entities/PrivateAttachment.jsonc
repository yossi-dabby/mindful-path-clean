{
  "name": "PrivateAttachment",
  "type": "object",
  "properties": {
    "owner_user_id": {
      "type": "string"
    },
    "owner_email": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "mime_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploading",
        "active",
        "deletion_pending"
      ]
    },
    "encryption_key": {
      "type": "string"
    },
    "encryption_iv": {
      "type": "string"
    },
    "signing_key": {
      "type": "string"
    },
    "superseded_file_uri": {
      "type": "string"
    },
    "encryption_version": {
      "type": "integer",
      "enum": [
        1
      ]
    }
  },
  "required": [
    "owner_user_id",
    "owner_email",
    "name",
    "mime_type",
    "size_bytes",
    "status"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "read": false,
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": false
  }
}
