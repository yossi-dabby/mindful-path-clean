{
  "name": "ConsentRecord",
  "type": "object",
  "properties": {
    "document": {
      "type": "string",
      "enum": [
        "ai_chat_terms_and_privacy"
      ],
      "description": "The consent document or bundle accepted by the user"
    },
    "version": {
      "type": "string",
      "description": "Immutable version identifier of the accepted document"
    },
    "language": {
      "type": "string",
      "enum": [
        "en",
        "he",
        "es",
        "fr",
        "de",
        "it",
        "pt"
      ],
      "description": "Language shown when consent was accepted"
    },
    "surface": {
      "type": "string",
      "enum": [
        "chat"
      ],
      "description": "Application surface where consent was accepted"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "Client-observed acceptance time in ISO 8601 format"
    }
  },
  "required": [
    "document",
    "version",
    "language",
    "surface",
    "accepted_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.mp_adult_policy": "2026-11-11",
        "data.mp_account_deletion_pending": false
      }
    },
    "read": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
