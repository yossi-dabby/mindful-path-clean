{
  "name": "ExerciseRecommendationFeedback",
  "type": "object",
  "properties": {
    "exercise_id": {
      "type": "string",
      "description": "Reference to Exercise entity"
    },
    "recommendation_reason": {
      "type": "string",
      "description": "Why it was recommended"
    },
    "feedback_type": {
      "type": "string",
      "enum": [
        "helpful",
        "not_relevant",
        "too_easy",
        "too_hard"
      ],
      "description": "User feedback on the recommendation"
    },
    "context": {
      "type": "object",
      "description": "Context when recommendation was given (mood, goals, etc)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional notes about this feedback record"
    }
  },
  "required": [
    "exercise_id",
    "feedback_type"
  ],
  "rls": {
    "create": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "read": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}
