{
  "name": "ForumComment",
  "type": "object",
  "properties": {
    "post_id": {
      "type": "string",
      "description": "Reference to ForumPost"
    },
    "content": {
      "type": "string",
      "description": "Comment content"
    },
    "is_anonymous": {
      "type": "boolean",
      "default": false,
      "description": "Whether to hide author identity"
    },
    "author_display_name": {
      "type": "string",
      "description": "Display name (anonymous or real)"
    },
    "upvotes": {
      "type": "number",
      "default": 0,
      "description": "Number of upvotes"
    },
    "parent_comment_id": {
      "type": "string",
      "description": "For threaded replies"
    }
  },
  "required": [
    "post_id",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.mp_adult_policy": "2026-11-11",
        "data.mp_account_deletion_pending": false
      }
    },
    "read": {
      "user_condition": {
        "data.mp_adult_policy": "2026-11-11",
        "data.mp_account_deletion_pending": false
      }
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "$or": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "data.mp_adult_policy": "2026-11-11",
            "data.mp_account_deletion_pending": false
          }
        },
        {
          "$or": [
            {
              "created_by": "{{user.email}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    }
  }
}
