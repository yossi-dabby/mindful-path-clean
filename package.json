{
  "name": "base44-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "generate:forms-index": "node scripts/generate-therapeutic-forms-index.mjs",
    "check:forms-index": "node scripts/check-therapeutic-forms-index.mjs",
    "check:agents": "node scripts/check-agent-config-policy.mjs",
    "check:agent-benchmark": "node scripts/check-agent-benchmark.mjs",
    "copy:pdf-worker": "node scripts/copy-pdf-worker.cjs",
    "postinstall": "node scripts/copy-pdf-worker.cjs",
    "predev": "npm run generate:forms-index && npm run copy:pdf-worker",
    "prebuild": "npm run generate:forms-index && npm run copy:pdf-worker",
    "pretest": "npm run generate:forms-index && npm run check:agents && npm run check:agent-benchmark",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "typecheck:report": "node scripts/typecheck-report.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run test/**/*.test.js",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:android": "playwright test -c playwright.android.config.ts",
    "test:e2e:android:matrix": "playwright test -c playwright.android.matrix.config.ts",
    "test:e2e:ios:matrix": "playwright test -c playwright.ios.matrix.config.ts",
    "android:build": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "ios:build": "npm run build && npx cap sync ios",
    "ios:sync": "npx cap sync ios",
    "ios:open": "npx cap open ios",
    "ios:add": "npx cap add ios",
    "ios:run": "npx cap run ios",
    "inventory:lucide": "node scripts/inventory-lucide-icons.mjs"
  },
